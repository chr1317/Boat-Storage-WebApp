# Demonstration values for local Docker Compose only. NEVER use these in production.
# Match DB_PASS to the demo MySQL root password in docker-compose.demo.yml.
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=boatdb
DB_DIALECT=mysql
DEV_RESET_DB=false
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DEFAULT_HALL_MARGIN_CM=20
LAUNCH_START_MONTH=10
LAUNCH_END_MONTH=4
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_BEFORE_RUNNING
SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET_BEFORE_RUNNING
